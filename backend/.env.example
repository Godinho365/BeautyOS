# Copie para backend/.env e ajuste. Nunca versione o .env real (ver .gitignore).
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-inseguro-troque-em-producao
DJANGO_ALLOWED_HOSTS=*
# Conecte como o role de APLICAÇÃO (não-superusuário) para a RLS valer. Ver ADR-0003.
DATABASE_URL=postgres://beautyos_app:beautyos_app@localhost:5432/beautyos
